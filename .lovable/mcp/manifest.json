{
  "version": 1,
  "sdk_version": "2.0.2",
  "path": "/mcp",
  "auth": {
    "type": "oauth",
    "issuer": "https://vtlecaojupfsawcobbid.supabase.co/auth/v1",
    "accepted_audiences": [
      "authenticated"
    ]
  },
  "mcp": {
    "server": {
      "name": "teachmate-pro",
      "version": "0.1.0",
      "title": "TeachMate Pro"
    },
    "tools": [
      {
        "name": "list_classes",
        "title": "List classes",
        "description": "List the signed-in teacher's schools/colleges and their classes, with student counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "search": {
              "type": "string",
              "description": "Optional filter matched against the class name."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_class_students",
        "title": "List class students",
        "description": "List the students on one of the signed-in teacher's class rosters.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "class_id": {
              "type": "string",
              "format": "uuid",
              "description": "Class id from list_classes."
            }
          },
          "required": [
            "class_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "add_class_students",
        "title": "Add students to a class",
        "description": "Add students to one of the signed-in teacher's classes. Students already on the roster (same name and student number) are skipped.",
        "annotations": {
          "readOnlyHint": false,
          "destructiveHint": false,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "class_id": {
              "type": "string",
              "format": "uuid",
              "description": "Class id from list_classes."
            },
            "students": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "description": "Student name."
                  },
                  "student_number": {
                    "type": "string",
                    "description": "Optional student number."
                  }
                },
                "required": [
                  "name"
                ],
                "additionalProperties": false
              },
              "minItems": 1,
              "maxItems": 500,
              "description": "Students to add."
            }
          },
          "required": [
            "class_id",
            "students"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_checkin_sessions",
        "title": "List seat check-in sessions",
        "description": "List the signed-in teacher's seat check-in sessions, newest first.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "ended",
                "all"
              ],
              "description": "Filter by session status. Defaults to all."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "How many sessions to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_checkin_attendance",
        "title": "Get check-in attendance",
        "description": "Get who checked in for one of the signed-in teacher's seat check-in sessions, plus the list of students who did not.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "description": "Check-in session id from list_checkin_sessions."
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_quiz_sessions",
        "title": "List quiz sessions",
        "description": "List the signed-in teacher's quiz sessions with question counts and status.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "active",
                "ended",
                "all"
              ],
              "description": "Filter by status. Defaults to all."
            },
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "How many sessions to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "get_quiz_results",
        "title": "Get quiz results",
        "description": "Get per-student scores and per-question accuracy for one of the signed-in teacher's quiz sessions.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "session_id": {
              "type": "string",
              "format": "uuid",
              "description": "Quiz session id from list_quiz_sessions."
            }
          },
          "required": [
            "session_id"
          ],
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      },
      {
        "name": "list_boards",
        "title": "List creative boards",
        "description": "List the signed-in teacher's creative boards with submission counts.",
        "annotations": {
          "readOnlyHint": true,
          "idempotentHint": true,
          "openWorldHint": false
        },
        "inputSchema": {
          "type": "object",
          "properties": {
            "limit": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "description": "How many boards to return (default 20)."
            }
          },
          "additionalProperties": false,
          "$schema": "http://json-schema.org/draft-07/schema#"
        },
        "outputSchema": null
      }
    ]
  }
}
